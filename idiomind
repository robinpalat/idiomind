if [[ $1 = '-h' ]] || [[ $1 = '--help' ]]; then
    echo " "
    echo "  idiomind [COMMAND] [OPTIONS]"
    echo
    echo "  Commands:"
    echo "    -s                         New session"
    echo "    add [text]                 Add note to active topic"
    echo "    new-topic [name]           Create a new topic"
    echo "    add-items [items]          Add items in batch"
    echo "    tasks                      Update tasks"
    echo "    topic                      Open current topic"
    echo "    panel                      Open main panel"
    echo "    stop                       Stop playback"
    echo "    restart-topic              Restart current topic"
    echo "    index                      Rebuild topic index"
    echo "    update-addons              Update addons"
    echo "    update-resources           Update resources"
    echo "    autostart                  Start in background"
    echo "    first-run                  Run first-time setup"
    echo
    echo "  Options:"
    echo "    -v, --version              Show program version"
    echo "    -h, --help                 Show this help message"
    echo
    echo
    exit
fi


if [[ $1 = x ]]; then
	bash -x /usr/share/idiomind/main.sh
else
	if [[ "$XDG_SESSION_TYPE" != 'x11' ]]; then
		GDK_BACKEND=x11 /usr/share/idiomind/main.sh "$@" & exit 0
	else
		/usr/share/idiomind/main.sh "$@" & exit 0
	fi
fi
