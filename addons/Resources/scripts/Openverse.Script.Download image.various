#!/bin/bash
# -*- ENCODING: UTF-8 -*-

# ============================================================
# Resource Provider: Openverse Image Search
# Resource Type: Script — Download image for words
# ============================================================
#
# Searches for and downloads images from the Openverse API
# (openverse.org), a repository of openly licensed content.
# No API key required. Multi-language support.
#
# Execution pattern: Direct execution (Pattern A)
#   $1 = word to search for
#   $2 = "_TEST_" flag for testing (uses TESTWORD instead)
#   Creates: $DT/$word.jpg (or $DT/$TESTWORD.jpg during test)

TLANGS="en, es, it, pt, ru, de, fr, ja, zh-cn"
USEDTO="Download image"
INFO="Openly-licensed images via the Openverse API (no key required)"
LANGUAGES="English"
STATUS="Ok"
VOICES=""
CONF="FALSE"
FILECONF=""
TESTWORD="cat"
EXECUT=""

_OPENVERSE_ENDPOINT="https://api.openverse.org/v1/images/"
_useragent='Idiomind/1.0 (learning app)'

if [[ "$2" = '_TEST_' ]]; then
    w="$TESTWORD"
else
    w="$1"
fi

if [[ "$1" != '_dclk_' ]]; then
    enc="$(printf '%s' "$w" | sed 's/ /%20/g')"
    json="$(curl -s --max-time 25 -A "$_useragent" \
        "${_OPENVERSE_ENDPOINT}?q=$enc&per_page=10")"

    # Try each result URL until we get a valid image
    for urimg in $(printf '%s' "$json" | jq -r '.results[] | select(.url != null) | .url' 2>/dev/null); do
        [ -n "$urimg" ] || continue
        wget -T 40 -q -U "$_useragent" -O "$DT/$w.jpg" "$urimg"
        if file -b --mime-type "$DT/$w.jpg" 2>/dev/null | grep -qE 'image'; then
            break
        fi
        rm -f "$DT/$w.jpg"
    done
fi
