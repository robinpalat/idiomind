#!/bin/bash
# -*- ENCODING: UTF-8 -*-

# ============================================================
# Resource Provider: Google Static Dictionary Audio
# Resource Type: TTS online — Download audio for words
# ============================================================
#
# Downloads pre-recorded pronunciation audio from Google's
# static dictionary audio CDN. No API key required.
# English only.
#
# Execution pattern: Source + URL export (Pattern B)
#   When sourced, exports TESTURL and URL for the caller to wget.

TLANGS="en"
USEDTO="Download audio (online)"
INFO="Search audio for words"
LANGUAGES="English"
STATUS="Ok"
VOICES=""
CONF="FALSE"
FILECONF=""
TESTWORD=""
EXECUT=""

export TESTURL="http://ssl.gstatic.com/dictionary/static/sounds/de/0/test.mp3"
export URL="http://ssl.gstatic.com/dictionary/static/sounds/de/0/${word}.mp3"
export EX='mp3'
