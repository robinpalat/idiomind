#!/bin/bash
# -*- ENCODING: UTF-8 -*-

# ============================================================
# Resource Provider: Ispeech Text-to-Speech
# Resource Type: TTS online — Convert text to audio
# ============================================================
#
# Converts text to speech using the Ispeech REST API.
# Requires a 32-character API key from ispeech.org.
#
# This provider also serves the Download audio variant:
#   Ispeech.TTS online.Download audio.various
# Both share the same configuration file and API key.
# If the key is invalid, both variants are auto-disabled.
#
# API documentation: https://ispeech.org/api
#
# Execution pattern: Source + internal config + URL export (Pattern C)
#   When sourced, exports URL and EX for the caller to wget.

# ------------------------------------------------------------
# Source common utilities
# ------------------------------------------------------------

_RES_DIR="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")")"
[ -f "$_RES_DIR/common.sh" ] && source "$_RES_DIR/common.sh"
_msgs_dir="$HOME/.config/idiomind/addons/resources/msgs"

# ------------------------------------------------------------
# Provider metadata
# ------------------------------------------------------------

INFOAPI="https://api.ispeech.org/api"
TLANGS="zh-cn, en, ja, pt, es, ru, it, de, fr"
USEDTO="Convert text to audio (online)"
INFO="Text-to-speech via the Ispeech REST API (API key required)"
LANGUAGES="English, Spanish, Portuguese, Russian, Italian, German, French, Chinese"
STATUS="Ok"
VOICES=""
CONF="TRUE"
FILECONF="$HOME/.config/idiomind/addons/resources/Ispeech.cfg"
CONFFIELDS="key voice speed"
CONFKEY_HIDDEN="key"
TESTSTRING="test"
EXECUT=""
EX='mp3'

# ------------------------------------------------------------
# Provider-specific constants
# ------------------------------------------------------------

_ISPEECH_ENDPOINT="https://api.ispeech.org/api/rest"
_ISPEECH_KEY_LENGTH=32

# Ispeech uses provider-specific voice names per language.
# This mapping is provider-internal, not shared with other providers.

_get_ispeech_voice()
{
    case "$1" in
        en)    echo "ukenglishmale" ;;
        es)    echo "eurspanishmale" ;;
        pt)    echo "brportuguesefemale" ;;
        ru)    echo "rurussianfemale" ;;
        it)    echo "euritalianmale" ;;
        de)    echo "eurgermanfemale" ;;
        fr)    echo "eurfrenchmale" ;;
        zh-cn) echo "chchinesefemale" ;;
        ja)    echo "jpjapanesefemale" ;;
        *)     echo "ukenglishmale" ;;
    esac
}

# Ispeech uses provider-specific test words per language.
_get_ispeech_test_word()
{
    case "$1" in
        en)    echo "test" ;;
        es)    echo "prueba" ;;
        pt)    echo "teste" ;;
        ru)    echo "тест" ;;
        it)    echo "prova" ;;
        de)    echo "Prüfung" ;;
        fr)    echo "tester" ;;
        zh-cn) echo "测试" ;;
        ja)    echo "テスト" ;;
        *)     echo "test" ;;
    esac
}

# Voces disponibles por idioma según https://ispeech.org/api
# (alias del parámetro "voice"; la primera es la Default que el
# script usaba hasta ahora para ese idioma).
_ispeech_voices_for()
{
    case "$1" in
        en)    echo "ukenglishmale usenglishfemale usenglishmale ukenglishfemale auenglishfemale caenglishfemale" ;;
        es)    echo "eurspanishmale eurspanishfemale usspanishfemale usspanishmale" ;;
        pt)    echo "brportuguesefemale eurportuguesefemale eurportuguesemale" ;;
        ru)    echo "rurussianfemale rurussianmale" ;;
        it)    echo "euritalianmale euritalianfemale" ;;
        de)    echo "eurgermanfemale eurgermanmale" ;;
        fr)    echo "eurfrenchmale eurfrenchfemale" ;;
        zh-cn) echo "chchinesefemale hkchinesefemale twchinesefemale" ;;
        ja)    echo "jpjapanesefemale" ;;
        *)     echo "ukenglishmale usenglishfemale usenglishmale ukenglishfemale" ;;
    esac
}

# Opciones del combo "voice" para el diálogo (Default = voz de la tabla).
_ispeech_voice_opts()
{
    local _l="${lgt:-en}" _list
    _list="$(_ispeech_voices_for "$_l")"
    [ -z "$_list" ] && _list="$(_ispeech_voices_for en)"
    tr ' ' '!' <<< "Default ${_list}"
}

# Combo de configuración: voz según idioma actual + velocidad.
# NOTA: se evalúa al hacer source, cuando $lgt ya está exportado
# (cnfg.sh dclk y test.sh lo fijan antes).
CONFOPTS="voice|$(_ispeech_voice_opts)
speed|Slow!Normal!Fast"

# Check API key validity and auto-disable related variants if invalid.
# Both the Convert and Search/Download variants share the same key.
# If the key is missing or wrong length, both are disabled.
#
# This logic is specific to Ispeech: the API requires exactly 32 characters.

_check_ispeech_key()
{
    local _key="$1"
    if [ -z "$_key" ] || [ "${#_key}" -ne "$_ISPEECH_KEY_LENGTH" ]; then
        local _convert="Ispeech.TTS online.Convert text to audio.various"
        local _search="Ispeech.TTS online.Search audio.various"
        resource_write_error \
            "<span color='#C15F27'>No key configuration</span>" \
            "$_msgs_dir" "$_convert"
        resource_write_error \
            "<span color='#C15F27'>No key configuration</span>" \
            "$_msgs_dir" "$_search"
        # Auto-disable both variants (skip during test runs)
        if [ ! -d "$DT/resources_test" ]; then
            local _dc_a="$HOME/.config/idiomind/addons"
            [ -f "$_dc_a/resources/enables/$_convert" ] && \
                mv -f "$_dc_a/resources/enables/$_convert" "$_dc_a/resources/disables/$_convert"
            [ -f "$_dc_a/resources/enables/$_search" ] && \
                mv -f "$_dc_a/resources/enables/$_search" "$_dc_a/resources/disables/$_search"
        fi
        return 1
    fi
    return 0
}

# Parse Isponse error responses.
# Ispeech returns "result=error" with an error code in the response body.
_check_ispeech_error()
{
    local _body="$1" _fname="$2"
    if echo "$_body" | grep -q "result=error"; then
        local _code
        _code=$(echo "$_body" | grep -o "error=[0-9]*" | grep -o "[0-9]*")
        local _msg
        case "$_code" in
            1)   _msg="Invalid credentials or API key" ;;
            3)   _msg="Insufficient credits (quota exhausted)" ;;
            997) _msg="No API access" ;;
            *)   _msg="API error (code $_code)" ;;
        esac
        resource_write_error \
            "<span color='#C15F27'>$_msg</span>" \
            "$_msgs_dir" "$_fname"
        return 0
    fi
    return 1
}

# ------------------------------------------------------------
# Main
# ------------------------------------------------------------
# When sourced by cnfg.sh (no arguments), only metadata is read.
# When sourced by add.sh/test.sh, the full flow runs.

if [ "$1" = "_dclk_" ]; then
    :

else
    # NOTE: test.sh and dwld1 source this provider WITHOUT arguments to
    # read metadata and export URL/TESTURL, so config + URL export must
    # run here. Only the live TESTURL validation below needs $2.

    # Read config
    api_key=$(resource_read_config "$FILECONF" "key")
    speed=$(resource_read_config "$FILECONF" "speed")
    voice=$(resource_read_config "$FILECONF" "voice")

    # Validate key (disables both Convert and Search variants on failure)
    _check_ispeech_key "$api_key" || return 0 2>/dev/null || exit 0

    # Velocidad: la API admite -10 (lenta) .. 10 (rápida), 0 = normal.
    # El combo ofrece Slow/Normal/Fast; se acepta número directo por
    # compatibilidad con valores manuales antiguos.
    case "$speed" in
        Slow)   s=-2 ;;
        Normal|"") s=0 ;;
        Fast)   s=2 ;;
        *)
            if [[ "$speed" =~ ^-?(10|[0-9])$ ]]; then
                s="$speed"
            else
                s=0
            fi ;;
    esac

    # Voz: Default/vacío -> voz por defecto del idioma. Solo se envía si
    # es válida para el lgt actual; así un cambio de idioma no rompe con
    # voz obsoleta (antes $voice se ignoraba siempre).
    v=$(_get_ispeech_voice "$lgt")
    if [ -n "$voice" ] && [ "$voice" != "Default" ]; then
        _allowed=" $(_ispeech_voices_for "$lgt") "
        if grep -Fq " ${voice} " <<< "$_allowed" 2>/dev/null; then
            v="$voice"
        fi
    fi
    _test=$(_get_ispeech_test_word "$lgt")

    # Pitch 100 = default documentado (0 es el tono más grave).
    export TESTURL="${_ISPEECH_ENDPOINT}?apikey=${api_key}&action=convert&voice=${v}&speed=${s}&pitch=100&text=${_test}"
    export URL="${_ISPEECH_ENDPOINT}?apikey=${api_key}&action=convert&voice=${v}&speed=${s}&pitch=100&text=${word}"
    export EX='mp3'

    # Test the API when called with a test parameter
    if [ -n "${2}" ] && [ "$2" != "" ]; then
        # Evita "ignored null byte in input": igual que Voicerss, la
        # respuesta OK es audio binario. Usar archivo temporal.
        _tmp_resp="$(mktemp 2>/dev/null || echo "/tmp/.ispeech_resp_$$")"
        if wget -T 15 -q -O "$_tmp_resp" "${TESTURL}" 2>/dev/null; then
            if file -b "$_tmp_resp" 2>/dev/null | grep -qiE 'text|empty' \
                || grep -q "result=error" "$_tmp_resp" 2>/dev/null; then
                _body="$(cat "$_tmp_resp" 2>/dev/null)"
                [ -n "$_body" ] && _check_ispeech_error "$_body" "$(basename "$0")"
            fi
        fi
        rm -f "$_tmp_resp"
    fi
fi
