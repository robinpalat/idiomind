#!/bin/bash
# -*- ENCODING: UTF-8 -*-

# Download audio variant for VoiceRSS.
# Sources the Convert variant to share configuration and API key.
# The Convert script exports URL/EX which the caller uses for wget.

dir="/usr/share/idiomind/addons/Resources/scripts"
source "$dir/Voicerss.TTS online.Convert text to audio.various"
TLANGS="zh-cn, en, pt, es, ru, it, de, fr"
EXECUT=""
