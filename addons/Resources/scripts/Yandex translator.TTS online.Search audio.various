#!/bin/bash
# -*- ENCODING: UTF-8 -*-

# ============================================================
# Resource Provider: Yandex Text-to-Speech — Legacy Search API
# Resource Type: TTS online — Search audio for words
# ============================================================
#
# Provides word pronunciation audio via the legacy Yandex TTS endpoint.
# This endpoint does NOT require an API key.
#
# API documentation: https://developer.tech.yandex.ru
#
# Note: This uses a different endpoint and language format (xx_XX)
# than the Cloud API variants (xx-XX). It is a separate provider
# that happens to share the Yandex name.
#
# Execution pattern: Source + URL export (Pattern B)
#   When sourced, exports TESTURL and URL for the caller to wget.

# ------------------------------------------------------------
# Provider metadata
# ------------------------------------------------------------

TLANGS="en, pt, es, ru, it, de, fr"
INFO="Convert text to audio (online) https://developer.tech.yandex.ru"
LANGUAGES="English, Russian"
STATUS="Ok"
CONF="FALSE"
FILECONF=""
TESTWORD=""
EXECUT=""

# Language mapping for legacy endpoint (format: "xx_XX").
# Different from the Cloud API format.

case "$lgt" in
    en) t="en_GB";  _test="test" ;;
    es) t="es_ES";  _test="prueba" ;;
    pt) t="pt_PT";  _test="teste" ;;
    ru) t="ru_RU";  _test="тест" ;;
    it) t="it_IT";  _test="prova" ;;
    de) t="de_DE";  _test="Prüfung" ;;
    fr) t="fr_FR";  _test="tester" ;;
esac

export TESTURL="http://tts.voicetech.yandex.net/tts?format=mp3&quality=hi&platform=web&application=translate&lang=$t&text=${_test}"
export URL="http://tts.voicetech.yandex.net/tts?format=mp3&quality=hi&platform=web&application=translate&lang=$t&text=${word}"
export EX='mp3'
