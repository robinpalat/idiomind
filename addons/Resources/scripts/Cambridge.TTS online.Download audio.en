#!/bin/bash
# -*- ENCODING: UTF-8 -*-

# ============================================================
# Resource Provider: Cambridge Dictionary Audio
# Resource Type: TTS online — Download audio for words
# ============================================================
#
# Resolves per-word US pronunciation audio by scraping the
# Cambridge Dictionary page. The media path is irregular and
# cannot be guessed reliably, so page scraping is required.
# No API key required. English only.
#
# Execution pattern: Source + URL export (Pattern B)
#   This provider scrapes the dictionary page at source time
#   to resolve the actual audio URL for the given word.

TLANGS="en"
INFO="Search audio for words"
LANGUAGES="English"
STATUS="Ok"
VOICES=""
CONF="FALSE"
FILECONF=""
TESTWORD=""
EXECUT=""

export TESTURL="https://dictionary.cambridge.org/media/english/us_pron/t/tes/test_/test.mp3"

# Scrape the Cambridge Dictionary page to find the US pronunciation URL.
# The audio path varies per word and cannot be constructed from a pattern.
if [ -n "$word" ] && [ -z "$URL" ]; then
    page="$(curl -s -m 20 -A "$useragent" \
        "https://dictionary.cambridge.org/dictionary/english/${word}")"
    pron="$(printf '%s' "$page" | grep -oP '(?<!//)(media/english/us_pron/[^"]*\.mp3)' | head -1)"
    if [ -n "$pron" ]; then
        export URL="https://dictionary.cambridge.org/${pron}"
    else
        export URL=""
    fi
fi

export EX='mp3'
