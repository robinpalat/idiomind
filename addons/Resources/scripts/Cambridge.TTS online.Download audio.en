#!/bin/bash

# Cambridge Dictionary pronunciation (online).
# Resolves the per-word US pronunciation audio by scraping the dictionary
# page (the media path is irregular and cannot be guessed reliably).
# No API key required.

TLANGS="en"
INFO="Search audio for words"
LANGUAGES="English"
STATUS="Ok"
VOICES=""
CONF="FALSE"
FILECONF=""
TESTWORD=""
EXECUT=""

# static known-good test audio
export TESTURL="https://dictionary.cambridge.org/media/english/us_pron/t/tes/test_/test.mp3"

if [ -n "$word" ] && [ -z "$URL" ]; then
    page="$(curl -s -m 20 -A "$useragent" \
        "https://dictionary.cambridge.org/dictionary/english/${word}")"
    pron="$(printf '%s' "$page" |grep -oP '(?<!//)(media/english/us_pron/[^"]*\.mp3)' |head -1)"
    if [ -n "$pron" ]; then
        export URL="https://dictionary.cambridge.org/${pron}"
    else
        export URL=""
    fi
fi

export EX='mp3'
