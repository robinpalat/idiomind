#!/bin/bash
# -*- ENCODING: UTF-8 -*-

# ============================================================
# Resource Provider: Festival Text-to-Speech
# Resource Type: TTS offline — Convert text to audio
# ============================================================
#
# Uses the Festival speech synthesis system with text2wave and sox.
# Requires festival and sox packages to be installed.
#
# Installation: sudo apt install festival sox
#
# Execution pattern: Direct execution (Pattern A)
#   $1 = text to synthesize
#   $2 = output file path (mp3)

# ------------------------------------------------------------
# Provider metadata
# ------------------------------------------------------------

TLANGS="en"
INFO="Convert text to audio (offline)"
LANGUAGES="English"
STATUS="Ok"
VOICES=""
CONF="FALSE"
FILECONF=""
TESTSTRING="Example"
TESTWORD="Example"
EXECUT="festival"
EX="mp3"

# ------------------------------------------------------------
# Main
# ------------------------------------------------------------

if [ "$1" = "_dclk_" ]; then
    :

elif [ -n "$2" ]; then
    echo "$1" | text2wave -o "$DT/OUT.wav"
    sox -t wav -c 1 "$DT/OUT.wav" "$2"
fi
