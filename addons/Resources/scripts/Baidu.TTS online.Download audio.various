#!/bin/bash
# -*- ENCODING: UTF-8 -*-

# Baidu TTS (unofficial free endpoint) for word pronunciation.
# Endpoint: https://fanyi.baidu.com/gettts
# Works for: zh-cn, en, ja (pt/es return HTTP 403 with this free endpoint).

TLANGS="zh-cn, en, ja"
INFO="Search audio for words"
LANGUAGES="Chinese, English, Japanese"
STATUS="Ok"
VOICES=""
CONF="FALSE"
FILECONF=""
TESTWORD=""
EXECUT=""

urlencode() {
    curl -s -m 2 -G --data-urlencode "v=$1" -o /dev/null -w "%{url_effective}" \
        "http://0.0.0.0/" 2>/dev/null |sed 's|http://0.0.0.0/?v=||;s/+/%20/g'
}

case "$lgt" in
    zh-cn) lan="zh" ;;
    en)    lan="en" ;;
    ja)    lan="jp" ;;
    *)     lan="zh" ;;
esac

t_enc="$(urlencode "${_test:-测试}")"
w_enc="$(urlencode "${word}")"

export TESTURL="https://fanyi.baidu.com/gettts?lan=$lan&text=${t_enc}&spd=5&source=web"
export URL="https://fanyi.baidu.com/gettts?lan=$lan&text=${w_enc}&spd=5&source=web"
export EX='mp3'
