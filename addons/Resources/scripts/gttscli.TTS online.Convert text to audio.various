#!/bin/bash
# -*- ENCODING: UTF-8 -*-

# ============================================================
# Resource Provider: gTTS (Google Text-to-Speech CLI)
# Resource Type: TTS offline — Convert text to audio
# ============================================================
#
# Uses the gtts-cli command-line tool (pip install gTTS).
# Requires the gtts-cli binary to be installed.
#
# Installation: sudo apt install python3-gtts
#   or: pip install gTTS
#
# Execution pattern: Direct execution (Pattern A)
#   $1 = text to synthesize
#   $2 = output file path (mp3)

# ------------------------------------------------------------
# Provider metadata
# ------------------------------------------------------------

TLANGS="en"
USEDTO="Convert text to audio (offline)"
INFO="Offline TTS via the gtts-cli tool (requires gtts-cli installed)"
LANGUAGES="English"
STATUS="Ok"
VOICES=""
CONF="FALSE"
FILECONF=""
TESTSTRING="this is an example"
TESTWORD=""
EXECUT="gtts-cli"
EX="mp3"

# ------------------------------------------------------------
# Main
# ------------------------------------------------------------

if [ "$1" = "_dclk_" ]; then
    :

elif [ -n "$2" ]; then
    gtts-cli -o "$2" "$1"
fi
