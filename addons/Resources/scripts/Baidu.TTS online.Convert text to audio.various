#!/bin/bash
# -*- ENCODING: UTF-8 -*-

# Baidu TTS (unofficial free endpoint).
# Endpoint: https://fanyi.baidu.com/gettts
# Works for: zh-cn, en, ja (pt/es return HTTP 403 with this free endpoint).
# No API key required.

EXECUT="curl"
TESTSTRING="测试"
EX="mp3"

if [ "$1" = "_dclk_" ]; then
    TLANGS="zh-cn, en, ja"
    INFO="Convert text to audio (online)"
    LANGUAGES="Chinese, English, Japanese"
    STATUS="Ok"
    VOICES=""
    CONF="FALSE"
    FILECONF=""
    TESTWORD=""
elif [ -n "$2" ]; then
    case "$lgt" in
        zh-cn) lan="zh" ;;
        en)    lan="en" ;;
        ja)    lan="jp" ;;
        *)     lan="zh" ;;
    esac
    curl -s -m 51 -G \
        --data-urlencode "lan=$lan" \
        --data-urlencode "text=$1" \
        --data-urlencode "spd=5" \
        --data-urlencode "source=web" \
        "https://fanyi.baidu.com/gettts" -o "$2"
fi
