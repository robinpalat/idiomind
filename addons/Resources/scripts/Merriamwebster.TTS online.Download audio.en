#!/bin/bash
# -*- ENCODING: UTF-8 -*-

# ============================================================
# Resource Provider: Merriam-Webster Audio
# Resource Type: TTS online — Download audio for words
# ============================================================
#
# Downloads US pronunciation audio from Merriam-Webster.
# The URL includes zero-padding based on word length.
# No API key required. English only.
# Only works for words shorter than 6 characters.
#
# Execution pattern: Source + URL export (Pattern B)

TLANGS="en"
USEDTO="Download audio (online)"
INFO="Search audio for words"
LANGUAGES="English"
STATUS="Ok"
VOICES=""
CONF="FALSE"
FILECONF=""
TESTWORD=""
EXECUT=""

# Merriam-Webster pads short words with zeros in the URL path.
# Words 6+ characters use a different URL structure not supported here.
if [ ${#word} -lt 6 ]; then
    c="0000000"
    _test="test"
    export TESTURL="http://media.merriam-webster.com/audio/prons/en/us/mp3/${_test:0:1}/${_test}${c::-${#_test}}1.mp3"
    export URL="http://media.merriam-webster.com/audio/prons/en/us/mp3/${word:0:1}/${word}${c::-${#word}}1.mp3"
    export EX='mp3'
fi
